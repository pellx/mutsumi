# Copy to .env and fill values locally. Never paste credentials into chat.
# Coding agent only: these do NOT select the voice application's dialogue model.
# Current provider: Alibaba Cloud Model Studio, Beijing, pay-as-you-go.
# Fill a Model Studio API key, NOT an Alibaba Cloud AccessKey ID/Secret.
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=
QWEN_REASONING_EFFORT=

# Historical DeepSeek configuration; latest owner agreement permits Qwen only.
DEEPSEEK_API_KEY=

# Example for the official DeepSeek service. Change if using another provider.
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Choose the exact model with the project owner before the first paid run.
# Official Codex integration currently lists deepseek-flash and deepseek-v4-pro.
DEEPSEEK_MODEL=

# Runtime speech/LLM/TTS credentials will be added after provider selection.

# Owner-approved audio recognition comparison: Gemini 3.8 Flash.
# Use a Gemini key for this service; do not reuse Alibaba or DeepSeek keys.
# GEMINI_MODEL may be left empty for the selected trial default gemini-3.8-flash.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=

# Keep empty until the owner verifies the API project is on free tier.
# This is an owner attestation, not an API setting that prevents paid billing.
GEMINI_FREE_TIER_CONFIRMED=
# Optional explicit local proxy address for Gemini; no system settings change.
GEMINI_PROXY_URL=

# Deferred alternative: OpenRouter Gemini 3.8 Flash.
# Obtain an OpenRouter key; Google and coding-provider keys cannot be reused.
# Model and tier are pinned in the adapter; no automatic paid-tier/model fallback.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
OPENROUTER_SERVICE_TIER=
# Optional explicit local HTTP proxy; empty means direct access.
OPENROUTER_PROXY_URL=
# Selected runtime input analysis: OhMyGPT Gemini 3.8 Flash.
# Use a key issued by OhMyGPT; no Google, OpenRouter or coding key reuse.
# Model is fixed. Ordinary Chat Completions; Flex routing is not verified.
OHMYGPT_API_KEY=
OHMYGPT_BASE_URL=https://api.ohmygpt.com/v1
OHMYGPT_MODEL=
# Optional local HTTP proxy; empty means direct access.
OHMYGPT_PROXY_URL=
# Empty defaults to ohmygpt. google is explicit legacy direct mode.
MUTSUMI_ANALYSIS_PROVIDER=

# Local server configuration. Empty means project-relative data/, port 3000,
# and ffmpeg/ffprobe from PATH. Runtime mode is chosen by start/start:mock.
MUTSUMI_DATA_DIR=
MUTSUMI_PORT=
MUTSUMI_FFMPEG_BIN=
MUTSUMI_FFPROBE_BIN=
