{
  "name": "mutsumi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mutsumi prototype: understands emotion in manually recorded voice clips and replies with expressive synthesized speech.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test tests/acceptance/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "check": "npm run build && npm test",
    "start": "node tools/run-server.mjs",
    "start:mock": "node tools/run-server.mjs --mode=development-mock",
    "harness:check": "node tools/harness/run-qwen.mjs --check"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "26.6.3",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0"
  }
}
